# Skopiuj do .env i wskaż katalog z danymi na wspólnym dysku.
# .env jest w .gitignore i nigdy nie trafia do repozytorium.
#
# Struktura oczekiwana pod tą ścieżką:
#   raw/        dane dokładnie takie, jakie dostaliśmy (tylko do odczytu)
#   interim/    etapy pośrednie, wolno kasować
#   processed/  wynikowe zbiory dla reszty zespołu

KBR_DATA_ROOT="/sciezka/do/wspolnego/dysku/kbr-dane"
